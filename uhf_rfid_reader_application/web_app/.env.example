# Supabase — required by scripts/seed.ts and (later) src/server/db/.
# Local dev: run `supabase start` (requires Docker) and copy the printed values.
# Hosted: Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# Service role key — server-side only, NEVER exposed to the browser, NEVER
# committed. Required by the seed script because it creates Auth users directly
# via the Admin API.
SUPABASE_SERVICE_ROLE_KEY=

# Public client config (browser-safe) — used once src/server/db/ is built (Phase 0).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Redis — permission cache, tag/dedup cache, pub/sub (§8.1).
REDIS_URL=redis://localhost:6379

# Kafka — durable event backbone (§8.1).
KAFKA_BROKERS=localhost:9092

# API middleware (§8.3) — comma-separated list of allowed origins for CORS;
# never "*".
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret between web_app's server code and hardware-engine's internal
# API (§8.3.3) — only Next.js's server process and hardware-engine read this.
INTERNAL_HW_ENGINE_TOKEN=

# Realtime Gateway (§7.9, §8.1) — standalone Socket.IO process, run separately
# via `npm run dev:realtime`. Browsers/Flutter connect to this port directly.
REALTIME_GATEWAY_PORT=9010
